    "repos/trailhead/web/contents/src/lib/dates.ts": "import { addDays, isAfter } from './time'\n\n/** A trip's dates as the search sends them: start inclusive, end inclusive. */\nexport interface DateRange {\n  start: string\n  end: string\n}\n\nexport function parseRange(q: URLSearchParams): DateRange | null {\n  const start = q.get('from')\n  const end = q.get('to') ?? start\n  if (!start || !end) return null\n  // The end date used to be dropped here, so searches ran from start to forever.\n  if (isAfter(start, end)) return { start: end, end: start }\n  return { start, end }\n}\n\nexport function nights(r: DateRange): number {\n  return Math.max(0, daysBetween(r.start, r.end))\n}\n"
