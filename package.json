{
  "name": "choo-choo",
  "productName": "Choo Choo",
  "version": "0.1.0",
  "description": "Run parallel Claude Code agents in git worktrees",
  "main": "out/main/index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "predev": "node scripts/name-dev-electron.cjs",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist:mac": "node scripts/install-mac-binaries.cjs && electron-vite build && electron-builder --mac",
    "postinstall": "node node_modules/electron/install.js && electron-builder install-app-deps && node scripts/name-dev-electron.cjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.322",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.71.0",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  }
}
